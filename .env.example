# Copy this file to .env and fill in values. Never commit .env.

# --- Language model (writes the defect description and the SOP report) ---
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else none.
# Options: auto | gemini | claude | ollama | none
LLM_PROVIDER=auto
# Free: create a key at https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Paid alternative
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Local alternative (laptop only): install Ollama, then `ollama pull qwen2.5vl:3b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# --- Detection: files named like the notebooks write them ---
DETECTOR_MODE=auto
MODELS_DIR=models
HF_MODEL_REPO=
MODEL_BOTTLE=patchcore
MODEL_PCB=patchcore
THRESHOLD_POLICY=balanced
ONNX_INPUT_NORM=none

# --- SOP search: chroma (needs requirements-rag.txt) or keyword (no extra deps) ---
RAG_BACKEND=chroma

API_URL=http://localhost:8000
